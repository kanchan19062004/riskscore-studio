# RiskScore Studio — local secrets (DO NOT COMMIT real production secrets)
APP_NAME=RiskScore Studio API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg2://riskscore:riskscore@localhost:5432/riskscore
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SCORE_CACHE_TTL_SECONDS=3600
RATE_LIMIT_LOGIN_IP=10
RATE_LIMIT_LOGIN_EMAIL=5
RATE_LIMIT_REGISTER_IP=5
RATE_LIMIT_SCORE_USER=30
RATE_LIMIT_SCORE_IP=60
MAX_REQUEST_BODY_BYTES=65536

NEXT_PUBLIC_API_URL=http://localhost:8000
